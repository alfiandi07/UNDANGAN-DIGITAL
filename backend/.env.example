# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for MySQL.

DB_HOST=localhost
DB_USER=asm_user
DB_PASSWORD=ganti_password
DB_NAME=asmudangandigital

DATABASE_URL="mysql://asm_user:ganti_password@localhost:3306/asmudangandigital"

# JWT Authentication Secret
JWT_SECRET=ganti_dengan_random_secret_panjang_minimal_32_karakter

# Sakelar Fitur Simulasi Pembayaran (set 'false' saat akun Midtrans live resmi)
ENABLE_PAYMENT_SIMULATION=true
